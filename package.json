    "@iconify-json/simple-icons": "^1.2.86",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.8.2",
    "@nuxthub/core": "latest",
    "@nuxtjs/seo": "5.3.0",
    "@pinia/nuxt": "^0.11.3",
    "@takumi-rs/core": "^2.14.0",
    "@takumi-rs/wasm": "^2.14.0",
    "@vueuse/core": "^14.3.0",
    "agents": "^0.30.1",
    "ai": "^7.0.77",
    "cropperjs": "1.6.2",
    "drizzle-orm": "latest",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.10",
    "nanoid": "^5.1.11",
    "nuxt-auth-utils": "latest",
    "nuxt-authorization": "^0.3.5",
    "postgres": "latest",
    "shiki": "^4.4.3",
    "workers-ai-provider": "^4.0.0",
    "zod": "^3.25.76",
    "zod4": "npm:zod@^4.2.0"
