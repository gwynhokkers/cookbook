{
  "name": "megwyn-cookbook",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "patch-wrangler": "node scripts/patch-wrangler-d1-migrations.mjs",
    "db:migrate": "bunx wrangler d1 migrations apply DB --remote --env production",
    "evaluate:extraction": "bun scripts/evaluate-recipe-extraction-fixtures.mjs",
    "evaluate:extraction:enforce": "bun scripts/evaluate-recipe-extraction-fixtures.mjs --enforce",
    "import:ocr": "node scripts/recipe-import/ocr.mjs",
    "import:structure": "node scripts/recipe-import/structure_recipes.mjs",
    "import:audit": "node scripts/recipe-import/audit-recipes.mjs",
    "import:upload": "node scripts/recipe-import/upload.mjs",
    "sync:pull": "node scripts/recipe-sync/pull.mjs",
    "sync:load": "node scripts/recipe-sync/load.mjs",
    "sync:recipes": "node scripts/recipe-sync/sync.mjs",
    "dev": "nuxt dev",
    "mcp:dev": "wrangler dev -c mcp/wrangler.jsonc",
    "mcp:typecheck": "tsc -p mcp/tsconfig.json",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/vue": "^4.0.77",
    "@comark/nuxt": "^0.6.2",
    "@electric-sql/pglite": "^0.3.16",
