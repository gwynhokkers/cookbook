  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@iconify-json/lucide": "^1.2.111",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "latest",
    "happy-dom": "^20.11.6",
    "nuxt": "^4.4.8",
