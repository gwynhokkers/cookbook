{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cookbook-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,

  // Same D1 database as the Pages app. The Pages app owns its migrations;
  // this Worker only reads.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookbook",
      "database_id": "2ff1dfb8-a2d6-48a4-bd1b-9bd128d034c6"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "16838be6e2e0497abc0f5ece212d9954"
    }
  ],

  // GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are secrets (wrangler secret put).
  "vars": {
    "APP_ORIGIN": "https://cookbook.megwyn.co.uk",
    // Must be the origin clients use: it is the issuer and the token audience (`${MCP_ORIGIN}/mcp`).
    "MCP_ORIGIN": "https://cookbook-mcp.gwyn-29d.workers.dev"
  },

  "observability": {
    "enabled": true
  }
}
