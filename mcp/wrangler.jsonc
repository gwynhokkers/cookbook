{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cookbook-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,

  // Same D1 database as the Pages app. The Pages app owns its migrations;
  // this Worker only reads.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookbook",
      "database_id": "2ff1dfb8-a2d6-48a4-bd1b-9bd128d034c6"
    }
  ],

  "observability": {
    "enabled": true
  }
}
